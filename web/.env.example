NEXT_PUBLIC_SITE_URL=https://www.sideventsmanagement.com

# Secret Vercel Cron must present (as "Authorization: Bearer <value>") to call
# /api/cron/keep-alive - the daily Supabase keep-alive ping that stops the
# free-tier project from auto-pausing after 7 days of no API activity. Set
# this to a random value in Vercel's project env vars; the route works
# without it too (unauthenticated), so it's optional but recommended.
CRON_SECRET=

# Serve gallery/hero images from Supabase Storage (site-assets bucket)
# instead of the local /public folder. Leave unset/false until
# `node scripts/upload-site-assets.mjs` has been run successfully (its
# summary must show 0 failures) - flipping this on before every referenced
# asset is actually uploaded will 404 every image on the site.
NEXT_PUBLIC_USE_SUPABASE_ASSETS=false
